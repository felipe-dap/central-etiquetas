# Copy to .env on EACH computer. This file is never synchronized by Git.
# Absolute paths or paths relative to the project directory are accepted.
# Use forward slashes on Windows. Leave empty to use the defaults.
ETIQUETAS_INPUT_DIR=
ETIQUETAS_DATA_DIR=
ETIQUETAS_PRINTER=ZDesigner ZD220-203dpi ZPL
# Optional: Python interpreter for the background worker (default: current Python).
ETIQUETAS_PYTHON=
